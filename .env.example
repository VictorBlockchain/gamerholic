# Supabase Realtime + mirror (optional — without these, demo local store is used)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ICP network
NEXT_PUBLIC_IC_HOST=http://127.0.0.1:4943
NEXT_PUBLIC_DFX_NETWORK=local
# NEXT_PUBLIC_IC_NETWORK=ic

# Internet Identity (same as yoinx_new — use production II even when FE is local)
NEXT_PUBLIC_II_URL=https://identity.ic0.app
# Optional: only if you deploy II on local dfx (NOT mainnet id rdmx6-…)
# NEXT_PUBLIC_II_URL=http://<local_ii_canister_id>.localhost:4943
# Stable principal across domains (prod host only; omitted on localhost)
# NEXT_PUBLIC_II_DERIVATION_ORIGIN=https://gamerholic.fun
# NEXT_PUBLIC_APP_URL=https://gamerholic.fun

# After `dfx deploy` in this repo:
NEXT_PUBLIC_GH_BACKEND_CANISTER_ID=
NEXT_PUBLIC_GH_MEDIA_CANISTER_ID=
# Legacy aliases accepted by canisters.ts:
# NEXT_PUBLIC_GAMERHOLIC_CANISTER_ID=

# Dexsta XFT (media + game assets for profile avatars)
# Local defaults match dexsta `dfx deploy` IDs when on the same replica.
NEXT_PUBLIC_DEXSTA_XFT_CANISTER_ID=
NEXT_PUBLIC_DEXSTA_MEDIA_CANISTER_ID=
# Optional: HTTPS Dexsta app for /api/xft/user (e.g. http://localhost:3000)
# NEXT_PUBLIC_DEXSTA_API_URL=http://localhost:3000
# Aliases also accepted:
# NEXT_PUBLIC_XFT_CANISTER_ID=
# NEXT_PUBLIC_MEDIA_CANISTER_ID=

# Betable.fun market factory (create Esports markets from gamerholic)
# Local: dfx canister id market_factory  (from betable project)
NEXT_PUBLIC_BETABLE_MARKET_FACTORY_ID=
# Optional: https://betable.fun or http://localhost:3000
NEXT_PUBLIC_BETABLE_APP_URL=http://localhost:3000
# NEXT_PUBLIC_BETABLE_ESPORTS_CATEGORY=Esports
# % of creator fee sent to tournament escrow on resolve (0 = host keeps full 1%)
# NEXT_PUBLIC_BETABLE_ESCROW_SPLIT_PCT=100

# Shared secret for betable Esports APIs (outcomes + settle). Never expose as NEXT_PUBLIC_.
# Must match betable server GAMERHOLIC_API_SECRET.
GAMERHOLIC_API_SECRET=
# BETABLE_API_URL=http://localhost:3000
