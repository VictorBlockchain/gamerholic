# ── Dependencies ──────────────────────────────────────────
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ── Next.js ───────────────────────────────────────────────
.next/
out/
build/
dist/
.turbo/
.cache/
*.tsbuildinfo
next-env.d.ts

# ── Env & secrets (never commit) ──────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
secrets/
.credentials

# ── DFX / ICP ─────────────────────────────────────────────
.dfx/
canisters/**/.dfx/
canisters/**/target/
**/.vessel/
**/.mops/
**/*.wasm
**/*.wasm.gz
