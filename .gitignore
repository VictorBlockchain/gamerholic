.dfx/**/canister_ids.json

# ── Logs & debug ──────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dev.log
server.log

# ── Testing / coverage ────────────────────────────────────
coverage/
.nyc_output/
playwright-report/
test-results/

# ── OS / IDE ──────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~

# ── Tooling caches ────────────────────────────────────────
.eslintcache
.prettiercache

# ── Local / temp ──────────────────────────────────────────
tmp/
temp/
*.tmp
local-*
.claude/
.z-ai-config
prompt

# ── Large local archives (never push) ─────────────────────
*.zip
*.tar
*.tar.gz
